# Copy to .env and adjust. This file contains no secrets — only placeholders.

# --- database -------------------------------------------------------------------------
TGMCP_DB_URL=jdbc:postgresql://localhost:5432/tgmcp
TGMCP_DB_USER=tgmcp
# Required by docker-compose.yml -- it refuses to start without this set to something
# other than the placeholder below. Use a real, unique password for anything but a
# throwaway local database.
TGMCP_DB_PASSWORD=change-me
TGMCP_DB_PORT=5432
# docker-compose.yml binds the published database port to this address only (loopback
# by default). Change it only if a remote client has a specific, reviewed reason to
# reach Postgres directly rather than through the application.
TGMCP_DB_BIND=127.0.0.1

# --- server ---------------------------------------------------------------------------
TGMCP_PORT=8080
# Set to true whenever the app is reachable over HTTPS.
TGMCP_COOKIE_SECURE=false

# --- Telegram adapter -----------------------------------------------------------------
# MOCK  = fully synthetic demo data, no Telegram account contacted (default).
# TDLIB = real Telegram client. Requires libtdjson on the loader path, an api_id/api_hash
#         from https://my.telegram.org, and explicit authorization to connect an account.
TGMCP_TELEGRAM_ADAPTER=MOCK
TGMCP_TELEGRAM_API_ID=
TGMCP_TELEGRAM_API_HASH=
TGMCP_TDLIB_DIR=./tdlib-data
# Safety interlock: the TDLIB adapter refuses to start unless this is explicitly true.
TGMCP_REAL_ACCOUNT_AUTHORIZED=false

# --- keys (generate with: openssl rand -base64 32) ------------------------------------
# 32 bytes, base64. Kept outside the database on purpose.
TGMCP_SESSION_ENCRYPTION_KEY=
TGMCP_SESSION_KEY_ID=local-dev
TGMCP_CURSOR_SIGNING_KEY=

# --- OAuth / MCP ----------------------------------------------------------------------
# The issuer and the public base URL must be the URLs clients actually reach.
TGMCP_OAUTH_ISSUER=http://localhost:8080
TGMCP_PUBLIC_BASE_URL=http://localhost:8080
# Canonical resource identifier (RFC 8707). Tokens must name it in their audience.
TGMCP_MCP_RESOURCE=http://localhost:8080/mcp

# --- demo data ------------------------------------------------------------------------
TGMCP_SEED_DEMO=true
TGMCP_DEMO_EMAIL=owner@demo.invalid
TGMCP_DEMO_PASSWORD=change-me

# --- background work ------------------------------------------------------------------
TGMCP_SYNC_SCHEDULED=true
